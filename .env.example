# Required to instantiate GitHubClient. Never commit a real GitHub token.
# The CLI loads .env without overriding existing environment variables.
GITHUB_TOKEN=
# Monitored repositories, separated by commas (owner/repository).
GITLOG_REPOSITORIES=leopaulaferreira/gitlog
GITLOG_RAW_DIR=data/raw

# PostgreSQL for local development. Replace the placeholder password in .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gitlog
POSTGRES_USER=gitlog
POSTGRES_PASSWORD=replace-with-a-local-password

# Restricted ingestion role, provisioned by `make migrate`.
GITLOG_DB_USER=gitlog_ingestion
GITLOG_DB_PASSWORD=replace-with-a-different-local-password

# Analytics roles provisioned by `make analytics-init`.
DBT_USER=gitlog_dbt
DBT_PASSWORD=replace-with-a-dbt-password
METABASE_READER_USER=gitlog_metabase
METABASE_READER_PASSWORD=replace-with-a-reader-password
# Match id -u / id -g on Linux so dbt artifacts belong to your user.
LOCAL_UID=1000
LOCAL_GID=1000

# Metabase application database: separate from the GitLog warehouse.
METABASE_DB_PASSWORD=replace-with-a-metabase-db-password
METABASE_PORT=3000
# Optional automated local dashboard setup. `make demo-config` creates a password.
METABASE_ADMIN_EMAIL=admin@gitlog.local
METABASE_ADMIN_PASSWORD=
