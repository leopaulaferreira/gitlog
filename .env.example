# Reserved for Phase 1. Never commit a real GitHub token.
GITHUB_TOKEN=
# Reserved for ingestion configuration; comma-separated owner/repository values.
GITLOG_REPOSITORIES=spring-projects/spring-boot,facebook/react,kubernetes/kubernetes

# PostgreSQL for local development. Replace the placeholder password in .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gitlog
POSTGRES_USER=gitlog
POSTGRES_PASSWORD=replace-with-a-local-password
