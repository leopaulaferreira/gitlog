      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ],
      "date_range": [
        "fact_pull_requests",
        "created_date"
      ]
    },
    "visualization_settings": {}
  },
  {
    "key": "issues",
    "name": "Issues",
    "display": "scalar",
    "description": "Collected rows. Date filter applies to created_date in UTC. No contributors are inferred.",
