      ],
      "graph.metrics": [
        "commits"
      ]
    }
  },
  {
    "key": "merge_time",
    "name": "Pull Request Merge Time — Hours",
    "display": "bar",
    "description": "Weighted average elapsed creation-to-merge hours, for merges in the selected period. No merges means no average.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ],
      "date_range": [
        "fact_repository_daily_metrics",
        "activity_date"
      ]
    },
    "visualization_settings": {
      "graph.dimensions": [
        "full_name"
      ],
      "graph.metrics": [
        "average_pr_merge_time_hours"
      ]
    }
  },
  {
    "key": "repository_activity",
    "name": "Repository Activity Over Time — Commits",
    "display": "line",
    "description": "One series per repository, measured in collected commits, using UTC dates.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
