[
  {
    "key": "repositories",
    "name": "Repositories Monitored",
    "display": "scalar",
    "description": "Current repositories with ingested metadata. Date range does not apply to this snapshot KPI.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ]
    },
    "visualization_settings": {}
  },
  {
    "key": "commits",
    "name": "Commits Collected",
    "display": "scalar",
    "description": "Collected rows. Date filter applies to commit_date in UTC. No contributors are inferred.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ],
      "date_range": [
        "fact_commits",
        "commit_date"
      ]
    },
    "visualization_settings": {}
  },
  {
    "key": "pull_requests",
    "name": "Pull Requests",
    "display": "scalar",
    "description": "Collected rows. Date filter applies to created_date in UTC. No contributors are inferred.",
