      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ],
      "date_range": [
        "fact_issues",
        "created_date"
      ]
    },
    "visualization_settings": {}
  },
  {
    "key": "merged_prs",
    "name": "Merged Pull Requests",
    "display": "scalar",
    "description": "Collected rows. Date filter applies to merged_date in UTC. No contributors are inferred.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ],
      "date_range": [
        "fact_pull_requests",
        "merged_date"
      ]
    },
    "visualization_settings": {}
  },
  {
    "key": "closed_issues",
    "name": "Closed Issues",
    "display": "scalar",
    "description": "Collected rows. Date filter applies to closed_date in UTC. No contributors are inferred.",
