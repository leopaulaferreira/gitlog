    "visualization_settings": {}
  },
  {
    "key": "commits_over_time",
    "name": "Commits over time",
    "display": "line",
    "description": "Dated collected commits per UTC day. Undated commits remain in the fact and all-time KPI.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ],
      "date_range": [
        "fact_repository_daily_metrics",
        "activity_date"
      ]
    },
    "visualization_settings": {
      "graph.dimensions": [
        "activity_date"
      ],
      "graph.metrics": [
        "commits"
      ]
    }
  },
  {
    "key": "pull_requests_over_time",
    "name": "Pull Requests — Opened vs Merged",
    "display": "line",
    "description": "Events on their creation or merge date, not cohorts of PRs created together.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ],
      "date_range": [
        "fact_repository_daily_metrics",
        "activity_date"
      ]
    },
    "visualization_settings": {
      "graph.dimensions": [
        "activity_date"
      ],
      "graph.metrics": [
        "opened",
        "merged"
      ]
    }
  },
  {
    "key": "issues_over_time",
    "name": "Issues — Opened vs Closed",
    "display": "line",
    "description": "Creations and latest closure of currently closed issues; reopen history is unavailable.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ],
      "date_range": [
