        "activity_date",
        "full_name"
      ],
      "graph.metrics": [
        "commits"
      ]
    }
  },
  {
    "key": "primary_languages",
    "name": "Primary Languages — Current Snapshot",
    "display": "pie",
    "description": "Repository count by current primary language. Unknown is missing metadata; this is not language history or code volume.",
    "filters": {
      "repository": [
        "dim_repository",
        "full_name"
      ],
      "language": [
        "dim_repository",
        "primary_language"
      ]
    },
    "visualization_settings": {
      "pie.dimension": "primary_language",
      "pie.metric": "repositories"
    }
  },
  {
    "key": "repository_comparison",
    "name": "Repository comparison",
    "display": "table",
